# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# หากใช้ Neon Cloud Database ให้เปิดคอมเมนต์บรรทัดล่างนี้:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# การตั้งค่าสำหรับ Docker PostgreSQL Container
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=product_db
POSTGRES_PORT=5433

# การตั้งค่าสำหรับ Backend เชื่อมต่อ Database (Local Development)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=product_db
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_SSL=false

# ==========================================
# Backend Configuration
# ==========================================
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000

# ==========================================
# Frontend Configuration
# ==========================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000
